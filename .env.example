AI_SRE_ENVIRONMENT=development
AI_SRE_LOG_LEVEL=INFO
AI_SRE_ENABLE_API_DOCS=true
AI_SRE_API_V1_PREFIX=/api/v1
AI_SRE_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","backend"]
AI_SRE_CORS_ALLOWED_ORIGINS=["http://localhost:8501"]
AI_SRE_API_BASE_URL=http://localhost:8000
AI_SRE_MAX_UPLOAD_SIZE_BYTES=10485760

# Configure secrets through the deployment secret manager, not source control.
# Enable ingestion/indexing by setting all three service URLs:
# AI_SRE_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_sre_copilot
# AI_SRE_CHROMA_URL=http://localhost:8001
# AI_SRE_OLLAMA_BASE_URL=http://localhost:11434
AI_SRE_OLLAMA_CHAT_MODEL=llama3.1
AI_SRE_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_SRE_EMBEDDING_BATCH_SIZE=32
AI_SRE_TOP_K_RETRIEVE=15
AI_SRE_TOP_K_RERANK=5
AI_SRE_RCA_TIMEOUT_SECONDS=120
AI_SRE_RCA_MAX_ATTEMPTS=3
AI_SRE_RCA_RETRY_BACKOFF_SECONDS=0.25
